{
	admin off
	auto_https off
}

:80 {
	route {
		@blocked path /_synapse/admin* /_matrix/federation* /_matrix/key*
		respond @blocked 404

		@wellknown path /.well-known/matrix/client
		header @wellknown Content-Type application/json
		header @wellknown Access-Control-Allow-Origin *
		respond @wellknown `{"m.homeserver":{"base_url":"{{.PublicURL}}"}}` 200

		reverse_proxy /_switchboard/* hub:8090
		reverse_proxy synapse:8008
	}
}
