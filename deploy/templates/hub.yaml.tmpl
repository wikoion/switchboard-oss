# Generated by sb from templates/hub.yaml.tmpl. Do not edit.
listen: ":8090"
owner: "{{.OwnerMXID}}"
homeserver: http://synapse:8008
bridges:
{{- range .Bridges}}
  - id: {{.ID}}
    network: {{.Network}}
    kind: {{.Kind}}
    url: {{.URL}}
{{- else}} []
{{- end}}
{{- if .Push}}
# Synapse pushes through the hub, which holds back imported history and
# passes the rest to Sygnal. It reads messages as the owner through the
# double-puppet appservice.
push:
  gateway: http://sygnal:5000/_matrix/push/v1/notify
  as_token: {{.DoublePuppetAS}}
{{- end}}
