# Generated by sb from templates/sygnal.yaml.tmpl. Edit that file instead.
# Sygnal hands Synapse's pushes to APNs. Pushers are event_id_only, so no
# message text reaches Apple; the app's notification extension fetches it.
log:
  setup:
    version: 1
    formatters:
      normal:
        format: "%(asctime)s %(levelname)-5s %(name)s %(message)s"
    handlers:
      stderr:
        class: logging.StreamHandler
        formatter: normal
        stream: ext://sys.stderr
    root:
      handlers: [stderr]
      level: INFO
  access:
    x_forwarded_for: false

http:
  bind_addresses: ["0.0.0.0"]
  port: 5000

apps:
  # TestFlight and App Store builds.
  {{.Push.Topic}}:
    type: apns
    keyfile: /secrets/apns.p8
    key_id: {{.Push.KeyID}}
    team_id: {{.Push.TeamID}}
    topic: {{.Push.Topic}}
    platform: production
    convert_device_token_to_hex: false
  # Development-signed builds, such as installs from Xcode or `flutter run`.
  {{.Push.Topic}}.dev:
    type: apns
    keyfile: /secrets/apns.p8
    key_id: {{.Push.KeyID}}
    team_id: {{.Push.TeamID}}
    topic: {{.Push.Topic}}
    platform: sandbox
    convert_device_token_to_hex: false
