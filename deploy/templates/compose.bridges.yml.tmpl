# Generated by sb from bridges.yaml and switchboard.yaml. Do not edit.
services:{{if not .Bridges}} {}{{end}}
{{- range .Bridges}}
  {{.Service}}:
    image: {{.Image}}
{{- if .Build}}
    build: {{.Build}}
{{- end}}
    restart: unless-stopped
    volumes:
      - ./config/bridges/{{.ID}}:/data
    depends_on:
      synapse:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:{{.Port}}/_matrix/mau/ready >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      start_period: 60s
{{- end}}
