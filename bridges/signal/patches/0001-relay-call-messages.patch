Switchboard, November 2026 (against v0.2610.0): relay Signal call messages
for the app, which runs RingRTC itself. signalmeow raises every call message
it receives as an events.CallSignal, the connector passes it to
handleCallSignal (both in overlay/), and SendMessage stamps outgoing call
messages with the current time, as it does sync and receipt messages.

diff --git a/pkg/connector/handlesignal.go b/pkg/connector/handlesignal.go
index a25b77a..b95bed3 100644
--- a/pkg/connector/handlesignal.go
+++ b/pkg/connector/handlesignal.go
@@ -67,6 +67,8 @@ func (s *SignalClient) handleSignalEvent(rawEvt events.SignalEvent) bool {
 		return s.handleSignalMessageRequestResponse(evt)
 	case *events.Call:
 		return s.Main.Bridge.QueueRemoteEvent(s.UserLogin, s.wrapCallEvent(evt)).Success
+	case *events.CallSignal:
+		return s.handleCallSignal(evt)
 	case *events.ContactList:
 		s.handleSignalContactList(evt)
 	case *events.ACIFound:
diff --git a/pkg/signalmeow/receiving.go b/pkg/signalmeow/receiving.go
